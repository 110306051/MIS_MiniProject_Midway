# 複製這個檔案為 .env（本機開發），再填入下面的值。
# .env 不可以上傳到 GitHub（已列在 .gitignore）。

# ── 資料庫（必填）──────────────────────────────
# 本機 Docker：postgres://midway:midway@localhost:5432/midway
# 雲端（Neon / Supabase）：貼上它們給你的連線字串
DATABASE_URL=postgres://midway:midway@localhost:5432/midway

# ── Google Maps（選填，沒填會自動改用「估算模式」與開源地圖）──
# 伺服器用金鑰：Routes API、Places API (New)。只在後端使用，不會傳到瀏覽器。
GOOGLE_MAPS_SERVER_KEY=

# 瀏覽器用金鑰：Maps JavaScript API（顯示地圖）。會出現在網頁原始碼中，
# 必須在 Google Cloud 後台限制「網站（HTTP referrer）」。
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# 地圖樣式 ID（使用 Advanced Marker 需要）。開發時可用 DEMO_MAP_ID。
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# ── AI 取捨說明（選填，沒填會用規則模板）──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── 登入系統（Better Auth）─────────────────────
# 正式環境必填：一段 32 字以上的隨機字串，可用 `npx @better-auth/cli secret` 或任何密碼產生器產生
BETTER_AUTH_SECRET=89b821952ec0adda365c64fc65ad229bcae57acb571878914bff25129d032c01
# 網站網址：本機 http://localhost:3000；部署後改成正式網址
BETTER_AUTH_URL=http://localhost:3000
